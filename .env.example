NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/wpms
JWT_SECRET=change-this-to-something-long-and-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-long-random-string-different-from-jwt-secret
JWT_REFRESH_EXPIRES_IN=30d


# MinIO (S3-compatible) — dev
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=<the access key you just created>
S3_SECRET_KEY=<the secret key>
S3_BUCKET=worker-documents
S3_FORCE_PATH_STYLE=true

# Redis — chat presence, unread counts, message cache
REDIS_URL=redis://localhost:6379

# SMTP config
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@wpms.local

ADMIN_EMAIL=admin@wpms.com
ADMIN_PASSWORD=admin12345

# Payments — swap to a real provider later without touching PaymentsService
PAYMENT_GATEWAY_PROVIDER=mock
# Platform's cut of worker earnings, % (0 = worker keeps the full amount)
PLATFORM_COMMISSION_PERCENT=0
# On a customer cancelling an in-progress job: % refunded to customer, rest paid to worker
CANCEL_INPROGRESS_REFUND_PERCENT=50
# Live location
# IANA zone the marketplace operates in — scheduled tracking windows use this,
# not the server's local timezone
MARKET_TIMEZONE=Asia/Colombo
# Hour (market time) tracking opens on a scheduled job's day
SCHEDULED_TRACKING_START_HOUR=8
# Minimum gap between accepted pings for one job, ms (0 disables throttling)
LOCATION_MIN_PING_INTERVAL_MS=500
