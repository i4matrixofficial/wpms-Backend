    {
      "name": "List & read",
      "description": "List and mark-read flows. Run a Create request first so `notificationId` is set.",
      "item": [
        {
          "name": "List Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('list payload shape', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.items).to.be.an('array');",
                  "  pm.expect(body.data.total).to.be.a('number');",
                  "});",
                  "if (body?.data?.items?.length && body.data.items[0].id) {",
                  "  pm.collectionVariables.set('notificationId', body.data.items[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notifications?userId={{userId}}&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "notifications"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}",
                  "description": "Required recipient UUID"
                },
                {
                  "key": "unreadOnly",
                  "value": "true",
                  "description": "Set true to return unread only",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "1–100 (default 20)"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "≥ 0 (default 0)"
                }
              ]
            },
            "description": "`userId` is required. Optionally enable `unreadOnly=true`."
          },
          "response": []
        },
        {
          "name": "List Unread Only",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('items are unread', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  (body.data.items || []).forEach((item) => {",
                  "    pm.expect(item.isRead).to.eql(false);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notifications?userId={{userId}}&unreadOnly=true&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "notifications"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "unreadOnly", "value": "true" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "Same as list, filtered to `isRead = false`."
          },
          "response": []
        },
        {
          "name": "Mark One as Read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('isRead true', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.isRead).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notifications/{{notificationId}}/read?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "notifications", "{{notificationId}}", "read"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}",
                  "description": "Must own the notification"
                }
              ]
            },
            "description": "Marks a single notification as read. Create or List first so `notificationId` is set."
          },
          "response": []
        },
        {
          "name": "Mark All as Read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('updated count returned', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.updated).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notifications/read-all?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "notifications", "read-all"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}",
                  "description": "Required recipient UUID"
                }
              ]
            },
            "description": "Marks all unread notifications for the user as read. Returns `{ updated: number }`."
          },
          "response": []
        }
      ]
    }
  ]
